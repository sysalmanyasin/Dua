{
  "name": "dua",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Fazal Din's Pharma Plus. Plain HTML + JS modules; npm is used for dev tools only, the app needs no build.",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check:secrets": "node tools/check-secrets.mjs",
    "check:vendor": "node tools/check-vendor.mjs",
    "test:db": "bash supabase/tests/run.sh",
    "serve": "npx http-server -c-1 -p 8080 .",
    "verify": "npm run lint && npm run format:check && npm test && npm run check:secrets && npm run check:vendor"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.10",
    "vitest": "2.1.9"
  }
}
